DISPATCH_ENVIRONMENT=local
DISPATCH_LOG_LEVEL=INFO
DISPATCH_LOG_JSON=true

# Optional: if set, every API call must send X-API-Key
# DISPATCH_API_KEY=change-me

DISPATCH_DATABASE_URL=postgresql+asyncpg://dispatch:dispatch@localhost:5432/dispatch
DISPATCH_RABBITMQ_URL=amqp://dispatch:dispatch@localhost:5672/
DISPATCH_REDIS_URL=redis://localhost:6379/0

DISPATCH_DEFAULT_TASK_TIMEOUT_SECONDS=120
DISPATCH_DEFAULT_MAX_ATTEMPTS=3
DISPATCH_RETRY_BASE_DELAY_SECONDS=5
DISPATCH_RETRY_MAX_DELAY_SECONDS=120
DISPATCH_ROBOT_OFFLINE_AFTER_SECONDS=30
